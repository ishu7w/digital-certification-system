PORT=3001
# Generate a secret with: openssl rand -hex 32
SIGNING_SECRET=
ADMIN_EMAIL=
# Generate using the command in README.md. Never place a plain password here.
ADMIN_PASSWORD_HASH=
# Read-only sample workspace. Disable before hosting private certificates.
DEMO_MODE=true

# Hosted PostgreSQL URL. Keep this server-only and require sslmode=require.
DATABASE_URL=
# Optional one-time administrator enrollment; expires at a Unix millisecond timestamp.
ADMIN_SETUP_TOKEN=
ADMIN_SETUP_EXPIRES_AT=

# Canonical origin used by certificate QR codes in production.
PUBLIC_ORIGIN=https://digital-certification-system-mu.vercel.app

# Automated backups: configure only on the production server.
# BACKUP_ENCRYPTION_KEY is the same private key used by the local backup tool.
BACKUP_ENCRYPTION_KEY=
BACKUP_JOB_TOKEN=
# The private Vercel Blob store connection adds BLOB_STORE_ID automatically.
