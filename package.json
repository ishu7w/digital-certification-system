{
  "name": "credence",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "setup:admin": "node scripts/setup-admin.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "regenerator-runtime": "^0.14.1",
    "svix": "^2.7.0",
    "three": "^0.186.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
